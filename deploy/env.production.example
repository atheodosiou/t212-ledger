# Copy to /root/projects/t212-ledger/.env.production on the server (chmod 600). Never commit the real one.

# --- Compose ---
# Set by the deploy script to the commit being deployed; one line, exactly.
IMAGE_TAG=bootstrap
# Loopback port Nginx proxies /api/ to.
HOST_PORT=3300
# Long and random: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# --- API ---
NODE_ENV=production
DATABASE_URL=postgres://t212:<POSTGRES_PASSWORD>@db:5432/t212_ledger
# 32 random bytes, base64: openssl rand -base64 32. Keep a copy OFF this server: without it the stored
# Trading 212 keys (and the backups' copies) cannot be decrypted.
CREDENTIAL_ENCRYPTION_KEY=
# During a key rotation only (README, "Rotating the encryption key").
CREDENTIAL_ENCRYPTION_KEYS_OLD=
WEB_ORIGIN=https://ledger.theodosiou.me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Nginx on the host reaches the container through Docker's bridge network.
TRUST_PROXY=loopback,uniquelocal
LOG_FORMAT=json
